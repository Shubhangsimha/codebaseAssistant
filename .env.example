# Copy to .env and fill in your API keys before running docker-compose up.
#
# Free API keys:
#   Gemini: https://aistudio.google.com/app/apikey   (15 RPM, 1M tokens/day)
#   Groq:   https://console.groq.com/keys             (30 RPM fallback)
GEMINI_API_KEY=
GROQ_API_KEY=
DATA_DIR=./data
# Optional: comma-separated list of allowed CORS origins (default: http://localhost:3000)
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
